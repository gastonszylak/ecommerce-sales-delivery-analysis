{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-AR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-AR",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_unique_id",
            "dataType": "string",
            "sourceColumn": "customer_unique_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_state",
            "dataType": "string",
            "sourceColumn": "customer_state",
            "summarizeBy": "none"
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "valid",
            "dataType": "int64",
            "sourceColumn": "valid",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "product_value",
            "dataType": "double",
            "sourceColumn": "product_value",
            "summarizeBy": "sum"
          },
          {
            "name": "freight_value",
            "dataType": "double",
            "sourceColumn": "freight_value",
            "summarizeBy": "sum"
          },
          {
            "name": "payment_type",
            "dataType": "string",
            "sourceColumn": "payment_type",
            "summarizeBy": "none"
          },
          {
            "name": "is_delivered",
            "dataType": "int64",
            "sourceColumn": "is_delivered",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "delivery_days",
            "dataType": "double",
            "sourceColumn": "delivery_days",
            "summarizeBy": "sum"
          },
          {
            "name": "days_late",
            "dataType": "int64",
            "sourceColumn": "days_late",
            "summarizeBy": "sum"
          },
          {
            "name": "is_late",
            "dataType": "int64",
            "sourceColumn": "is_late",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "delay_bucket",
            "dataType": "string",
            "sourceColumn": "delay_bucket",
            "summarizeBy": "none",
            "sortByColumn": "delay_bucket_order"
          },
          {
            "name": "delay_bucket_order",
            "dataType": "int64",
            "sourceColumn": "delay_bucket_order",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "seller_late_handoff",
            "dataType": "int64",
            "sourceColumn": "seller_late_handoff",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "review_score",
            "dataType": "int64",
            "sourceColumn": "review_score",
            "summarizeBy": "sum"
          },
          {
            "name": "first_order",
            "dataType": "int64",
            "sourceColumn": "first_order",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_repurchased",
            "dataType": "int64",
            "sourceColumn": "customer_repurchased",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(CarpetaDatos & \"pbi_orders.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
                "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"order_id\", type text}, {\"customer_unique_id\", type text}, {\"customer_state\", type text}, {\"order_status\", type text}, {\"valid\", Int64.Type}, {\"order_date\", type date}, {\"product_value\", type number}, {\"freight_value\", type number}, {\"payment_type\", type text}, {\"is_delivered\", Int64.Type}, {\"delivery_days\", type number}, {\"days_late\", Int64.Type}, {\"is_late\", Int64.Type}, {\"delay_bucket\", type text}, {\"delay_bucket_order\", Int64.Type}, {\"seller_late_handoff\", Int64.Type}, {\"review_score\", Int64.Type}, {\"first_order\", Int64.Type}, {\"customer_repurchased\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "order_items",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "seller_id",
            "dataType": "string",
            "sourceColumn": "seller_id",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "price",
            "dataType": "double",
            "sourceColumn": "price",
            "summarizeBy": "sum"
          },
          {
            "name": "freight_value",
            "dataType": "double",
            "sourceColumn": "freight_value",
            "summarizeBy": "sum"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(CarpetaDatos & \"pbi_order_items.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
                "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"order_id\", type text}, {\"seller_id\", type text}, {\"category\", type text}, {\"price\", type number}, {\"freight_value\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Calendario",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "isNameInferred": true,
            "sourceColumn": "[Fecha]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "Año",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[Año]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none"
          },
          {
            "name": "MesNum",
            "dataType": "int64",
            "isNameInferred": true,
            "sourceColumn": "[MesNum]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "isNameInferred": true,
            "sourceColumn": "[Mes]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR Base = CALENDAR(DATE(2017,1,1), DATE(2018,8,31))\nRETURN SELECTCOLUMNS(Base, \"Fecha\", [Date], \"Año\", YEAR([Date]), \"MesNum\", MONTH([Date]), \"Mes\", YEAR([Date]) & \"-\" & FORMAT(MONTH([Date]), \"00\"))"
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Columna",
            "dataType": "string",
            "sourceColumn": "Columna",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Facturación",
            "expression": "CALCULATE(SUM(orders[product_value]), orders[valid] = 1)",
            "formatString": "\"R$ \"#,0",
            "displayFolder": "Ventas",
            "description": "Valor de productos vendidos (sin flete), excluye pedidos cancelados o no disponibles"
          },
          {
            "name": "Pedidos",
            "expression": "CALCULATE(COUNTROWS(orders), orders[valid] = 1)",
            "formatString": "#,0",
            "displayFolder": "Ventas"
          },
          {
            "name": "Ticket promedio",
            "expression": "DIVIDE([Facturación], [Pedidos])",
            "formatString": "\"R$ \"#,0.00",
            "displayFolder": "Ventas"
          },
          {
            "name": "Clientes",
            "expression": "CALCULATE(DISTINCTCOUNT(orders[customer_unique_id]), orders[valid] = 1)",
            "formatString": "#,0",
            "displayFolder": "Ventas"
          },
          {
            "name": "Facturación mes anterior",
            "expression": "CALCULATE([Facturación], DATEADD(Calendario[Fecha], -1, MONTH))",
            "formatString": "\"R$ \"#,0",
            "displayFolder": "Ventas"
          },
          {
            "name": "Crecimiento MoM %",
            "expression": "VAR Actual = [Facturación]\nVAR Anterior = [Facturación mes anterior]\nRETURN IF(NOT ISBLANK(Anterior), DIVIDE(Actual - Anterior, Anterior))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Ventas"
          },
          {
            "name": "Facturación categoría",
            "expression": "SUM(order_items[price])",
            "formatString": "\"R$ \"#,0",
            "displayFolder": "Ventas"
          },
          {
            "name": "Tasa de recompra",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(orders[customer_unique_id]), orders[customer_repurchased] = 1, orders[valid] = 1), [Clientes])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Clientes",
            "description": "% de clientes con más de un pedido"
          },
          {
            "name": "Pedidos entregados",
            "expression": "CALCULATE(COUNTROWS(orders), orders[is_delivered] = 1)",
            "formatString": "#,0",
            "displayFolder": "Logística"
          },
          {
            "name": "Pedidos tarde",
            "expression": "CALCULATE(COUNTROWS(orders), orders[is_late] = 1)",
            "formatString": "#,0",
            "displayFolder": "Logística"
          },
          {
            "name": "% Entregas tarde",
            "expression": "DIVIDE([Pedidos tarde], [Pedidos entregados])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Logística",
            "description": "Pedidos entregados después de la fecha estimada / pedidos entregados"
          },
          {
            "name": "Días de entrega promedio",
            "expression": "AVERAGE(orders[delivery_days])",
            "formatString": "0.0",
            "displayFolder": "Logística"
          },
          {
            "name": "% Despacho tardío del vendedor",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(orders), orders[seller_late_handoff] = 1), CALCULATE(COUNTROWS(orders), NOT ISBLANK(orders[seller_late_handoff])))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Logística"
          },
          {
            "name": "Nota promedio",
            "expression": "AVERAGE(orders[review_score])",
            "formatString": "0.00",
            "displayFolder": "Satisfacción"
          },
          {
            "name": "Nota promedio entregados",
            "expression": "CALCULATE(AVERAGE(orders[review_score]), orders[is_delivered] = 1)",
            "formatString": "0.00",
            "displayFolder": "Satisfacción"
          },
          {
            "name": "% Reseñas negativas",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(orders), orders[review_score] <= 2), CALCULATE(COUNTROWS(orders), NOT ISBLANK(orders[review_score])))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Satisfacción",
            "description": "Reseñas de 1 o 2 estrellas"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [Columna = text], {})",
                "in",
                "    Origen"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "d16bfe05-0f06-4536-be1f-e078e4ab51f8",
        "fromTable": "order_items",
        "fromColumn": "order_id",
        "toTable": "orders",
        "toColumn": "order_id"
      },
      {
        "name": "55140e41-03c5-49be-bda0-6c4805e71096",
        "fromTable": "orders",
        "fromColumn": "order_date",
        "toTable": "Calendario",
        "toColumn": "Fecha"
      }
    ],
    "expressions": [
      {
        "name": "CarpetaDatos",
        "kind": "m",
        "expression": "\"C:\\Users\\usuario\\Documents\\Portfolio\\ecommerce-sales-delivery-analysis\\data\\powerbi\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"CarpetaDatos\", \"orders\", \"order_items\", \"_Medidas\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.140.0.0"
      }
    ]
  }
}